# /etc/systemd/system/warren-backup.service  (started by warren-backup.timer)
#
# Runs examples/scripts/warren-backup, installed as /usr/local/sbin/warren-backup. It runs as
# root so it can read the relay's private state directory; it can write only the backup folder.
[Unit]
Description=Consistent warren relay state backup
After=warren-relay.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/warren-backup
# Environment=WARREN_BACKUP_KEEP_DAYS=90
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/warren
